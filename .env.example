# Supabase — find these in your project: Settings → API.
# Copy to .env.local (or .env) and fill in. NEVER put real secrets in this file.

# Browser + server. The publishable key is safe to expose to the browser, so it
# uses the NEXT_PUBLIC_ prefix (required for Next.js client code).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Server-only secret — NEVER exposed to the browser (no NEXT_PUBLIC_ prefix).
# Only needed for admin writes / scripts that must bypass RLS.
SUPABASE_SECRET_KEY="sb_secret_xxx"

# Project ref — for CLI / MCP / tooling.
SUPABASE_PROJECT_ID="your-project-ref"

# Shared secret guarding the ICS-sync cron endpoint (POST /api/cron/sync-ics).
# The scheduler must send it as the `x-cron-secret` header. Generate a random
# value (e.g. `openssl rand -hex 32`).
CRON_SECRET="change-me"
