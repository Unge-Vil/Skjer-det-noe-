# Supabase — find these in your Supabase project: Settings → API
# Used by both the browser and server clients.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-only secret (never exposed to the browser). Optional for now —
# only needed for admin writes / scripts that must bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
