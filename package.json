{
  "name": "skjer-det-noe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm test:unit",
    "test:a11y": "pnpm test:a11y:tokens && pnpm test:a11y:routes",
    "test:a11y:tokens": "node --test lib/design-tokens-a11y.test.mjs",
    "test:a11y:routes": "playwright test --config=playwright.a11y.config.ts",
    "test:unit": "pnpm test:security:feeds && pnpm test:security:service-worker && pnpm test:api:validation",
    "test:integration": "pnpm test:security:profiles && pnpm test:security:organizations && pnpm test:security:roles && pnpm test:security:media && pnpm test:security:integrity:audit && pnpm test:security:integrity && pnpm test:sync:lock && pnpm test:performance:nearby",
    "test:security:profiles": "node --env-file=.env scripts/test-profile-security.mjs",
    "test:security:organizations": "node --env-file=.env scripts/test-organization-status-security.mjs",
    "test:security:roles": "node --env-file=.env scripts/test-owner-editor-security.mjs",
    "test:security:feeds": "node --test lib/feed-security.test.mjs",
    "test:security:media": "node --env-file=.env scripts/test-media-security.mjs",
    "test:security:integrity:audit": "node --env-file=.env scripts/check-listing-integrity.mjs",
    "test:security:integrity": "node --env-file=.env scripts/test-listing-integrity.mjs",
    "test:security:service-worker": "node --test public/sw-cache-policy.test.mjs",
    "test:api:validation": "node --test lib/api/validation.test.mjs",
    "test:sync:lock": "node --env-file=.env scripts/test-feed-lock.mjs",
    "test:performance:nearby": "node --env-file=.env scripts/test-nearby-limits.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cap": "cap",
    "cap:sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@puckeditor/core": "^0.23.0",
    "@scalar/nextjs-api-reference": "^0.11.14",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tiptap/html": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "ical.js": "^2.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.4.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.104.0"
  }
}
